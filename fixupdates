#!/usr/bin/env bash
set -euo pipefail

API_PATH="/usr/local/bin/xray_v2ray_api.py"
CLEANUP_PATH="/usr/local/bin/xray_v2ray_cleanup_loop.sh"
API_SERVICE="/etc/systemd/system/xj-v2ray-api.service"
CLEANUP_SERVICE="/etc/systemd/system/xj-v2ray-cleanup.service"
XRAY_CONFIG_PATH="${XRAY_CONFIG_PATH:-/usr/local/etc/xray/config.json}"
if [ ! -f "$XRAY_CONFIG_PATH" ] && [ -f "/etc/xray/config.json" ]; then
  XRAY_CONFIG_PATH="/etc/xray/config.json"
fi
XRAY_CLIENTS_PATH="${XRAY_CLIENTS_PATH:-/etc/xray/v2ray_clients.json}"
XRAY_SERVICE_NAME="${XRAY_SERVICE_NAME:-xray}"
XJ_V2RAY_API_PORT="${XJ_V2RAY_API_PORT:-5003}"

if [ "$(id -u)" -ne 0 ]; then
  echo "Please run as root."
  exit 1
fi

command -v python3 >/dev/null 2>&1 || {
  apt-get update
  apt-get install -y python3 curl
}
command -v curl >/dev/null 2>&1 || {
  apt-get update
  apt-get install -y curl
}

mkdir -p "$(dirname "$XRAY_CLIENTS_PATH")"

cat > "$API_PATH" <<'PYEOF'
#!/usr/bin/env python3
import json
import os
import re
import shutil
import subprocess
import tempfile
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

HOST = "0.0.0.0"
PORT = int(os.environ.get("XJ_V2RAY_API_PORT", "5003"))
CONFIG_PATH = Path(os.environ.get("XRAY_CONFIG_PATH", "/usr/local/etc/xray/config.json"))
if not CONFIG_PATH.exists():
    CONFIG_PATH = Path("/etc/xray/config.json")
CLIENTS_PATH = Path(os.environ.get("XRAY_CLIENTS_PATH", "/etc/xray/v2ray_clients.json"))
SERVICE_NAME = os.environ.get("XRAY_SERVICE_NAME", "xray")
UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
)


def parse_expire(value):
    cleaned = (value or "").strip()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(cleaned, fmt)
        except ValueError:
            pass
    raise ValueError("Invalid expire format. Use YYYY-MM-DD or YYYY-MM-DD HH:MM:SS.")


def read_json(path, default):
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def write_json_atomic(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=path.name, dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        shutil.move(tmp_name, path)
    finally:
        if os.path.exists(tmp_name):
            os.remove(tmp_name)


def restart_xray():
    subprocess.run(["systemctl", "restart", SERVICE_NAME], check=False)


def client_template(protocol, uuid):
    if protocol in ("vless", "vmess"):
        return {"id": uuid}
    if protocol == "trojan":
        return {"password": uuid}
    if protocol == "shadowsocks":
        return {"method": "aes-128-gcm", "password": uuid}
    return None


def client_matches(client, uuid):
    return client.get("id") == uuid or client.get("password") == uuid


def add_uuid_to_config(uuid):
    config = read_json(CONFIG_PATH, {})
    changed = False
    for inbound in config.get("inbounds", []):
        protocol = inbound.get("protocol")
        template = client_template(protocol, uuid)
        if template is None:
            continue
        settings = inbound.setdefault("settings", {})
        clients = settings.setdefault("clients", [])
        if not any(client_matches(client, uuid) for client in clients):
            clients.append(template)
            changed = True
    if changed:
        write_json_atomic(CONFIG_PATH, config)
    return changed


def remove_uuid_from_config(uuid):
    config = read_json(CONFIG_PATH, {})
    changed = False
    for inbound in config.get("inbounds", []):
        settings = inbound.get("settings", {})
        clients = settings.get("clients")
        if not isinstance(clients, list):
            continue
        kept = [client for client in clients if not client_matches(client, uuid)]
        if len(kept) != len(clients):
            settings["clients"] = kept
            changed = True
    if changed:
        write_json_atomic(CONFIG_PATH, config)
    return changed


def load_clients():
    data = read_json(CLIENTS_PATH, {"clients": {}})
    clients = data.get("clients")
    if not isinstance(clients, dict):
        clients = {}
    return clients


def save_clients(clients):
    write_json_atomic(CLIENTS_PATH, {"clients": clients})


def cleanup_expired():
    clients = load_clients()
    now = datetime.now()
    removed = []
    changed_config = False
    for uuid, item in list(clients.items()):
        try:
            expire_at = parse_expire(item.get("expire", ""))
        except ValueError:
            continue
        if expire_at <= now:
            if remove_uuid_from_config(uuid):
                changed_config = True
            removed.append(uuid)
            clients.pop(uuid, None)
    if removed:
        save_clients(clients)
    if changed_config:
        restart_xray()
    return removed


def create_v2(uuid, expire):
    if not UUID_RE.match(uuid):
        raise ValueError("Invalid UUID.")
    expire_at = parse_expire(expire)
    cleanup_expired()
    changed_config = add_uuid_to_config(uuid)
    clients = load_clients()
    clients[uuid] = {"uuid": uuid, "expire": expire_at.strftime("%Y-%m-%d %H:%M:%S")}
    save_clients(clients)
    if changed_config:
        restart_xray()
    return {"uuid": uuid, "expire": clients[uuid]["expire"], "changed": changed_config}


def update_v2(uuid, expire):
    if not UUID_RE.match(uuid):
        raise ValueError("Invalid UUID.")
    expire_at = parse_expire(expire)
    clients = load_clients()
    if uuid not in clients:
        raise ValueError("UUID was not found.")
    clients[uuid] = {"uuid": uuid, "expire": expire_at.strftime("%Y-%m-%d %H:%M:%S")}
    save_clients(clients)
    return {"uuid": uuid, "expire": clients[uuid]["expire"], "changed": False}


class Handler(BaseHTTPRequestHandler):
    def respond(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        query = parse_qs(parsed.query)
        try:
            if parsed.path == "/create-v2":
                uuid = query.get("uuid", [""])[0]
                expire = query.get("expire", [""])[0]
                result = create_v2(uuid, expire)
                self.respond(200, {"ok": True, "message": "V2Ray UUID created.", **result})
                return
            if parsed.path == "/update":
                uuid = query.get("uuid", [""])[0]
                expire = query.get("expire", [""])[0]
                result = update_v2(uuid, expire)
                self.respond(200, {"ok": True, "message": "V2Ray UUID expiration updated.", **result})
                return
            if parsed.path == "/cleanup-expired":
                removed = cleanup_expired()
                self.respond(200, {"ok": True, "removed": removed})
                return
            if parsed.path == "/health":
                self.respond(200, {"ok": True, "service": "xj-v2ray-api"})
                return
            self.respond(404, {"ok": False, "message": "Not found."})
        except Exception as exc:
            self.respond(422, {"ok": False, "message": str(exc)})

    def log_message(self, fmt, *args):
        return


if __name__ == "__main__":
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    server.serve_forever()
PYEOF
chmod +x "$API_PATH"

cat > "$CLEANUP_PATH" <<'SHEOF'
#!/usr/bin/env bash
set -euo pipefail
while true; do
  curl -fsS "http://127.0.0.1:${XJ_V2RAY_API_PORT:-5003}/cleanup-expired" >/dev/null 2>&1 || true
  sleep 3
done
SHEOF
chmod +x "$CLEANUP_PATH"

cat > "$API_SERVICE" <<EOF
[Unit]
Description=XJ V2Ray API
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 $API_PATH
Restart=always
RestartSec=2
Environment=XRAY_CONFIG_PATH=$XRAY_CONFIG_PATH
Environment=XRAY_CLIENTS_PATH=$XRAY_CLIENTS_PATH
Environment=XRAY_SERVICE_NAME=$XRAY_SERVICE_NAME
Environment=XJ_V2RAY_API_PORT=$XJ_V2RAY_API_PORT

[Install]
WantedBy=multi-user.target
EOF

cat > "$CLEANUP_SERVICE" <<EOF
[Unit]
Description=XJ V2Ray Expired UUID Cleanup Loop
After=xj-v2ray-api.service
Requires=xj-v2ray-api.service

[Service]
Type=simple
ExecStart=$CLEANUP_PATH
Restart=always
RestartSec=2
Environment=XJ_V2RAY_API_PORT=$XJ_V2RAY_API_PORT

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now xj-v2ray-api.service
systemctl enable --now xj-v2ray-cleanup.service

echo "Installed XJ V2Ray API on port $XJ_V2RAY_API_PORT"
echo "Create:  http://SERVER_IP:$XJ_V2RAY_API_PORT/create-v2?uuid=UUID&expire=YYYY-MM-DD%20HH:MM:SS"
echo "Update:  http://SERVER_IP:$XJ_V2RAY_API_PORT/update?uuid=UUID&expire=YYYY-MM-DD%20HH:MM:SS"
echo "Cleanup: http://127.0.0.1:$XJ_V2RAY_API_PORT/cleanup-expired"
echo "Cleanup service runs every 3 seconds. Xray restarts only when expired UUIDs are removed from config.json."


UUID=$(cat /etc/xray/uuid)
curl "http://127.0.0.1:5003/create-v2?uuid=${UUID}&expire=2050-03-30"
